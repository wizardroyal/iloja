// Iloja — Postgres schema v1.
// Mirrors the domain types in packages/types/src/*. Prisma owns the migrations;
// Zod owns the runtime validation. Drift between them is a bug.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users & roles ─────────────────────────

enum UserRole {
  renter
  agent
  landlord
  operator
  admin
}

enum KycStatus {
  unverified
  pending
  verified
  rejected
}

enum AgentBadgeTier {
  new_tier      @map("new")
  blue
  silver
  gold
  diamond
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique
  email     String?    @unique
  fullName  String
  roles     UserRole[]
  kycStatus KycStatus  @default(unverified)
  // Encrypted — never returned by API. NIN/BVN are PII.
  ninCipher String?
  bvnCipher String?

  agentProfile AgentProfile?
  listings     Listing[]
  credibility  CredibilityEvent[] @relation("CredibilitySubject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  userId            String         @id
  badgeTier         AgentBadgeTier @default(new_tier)
  credibilityScore  Float          @default(0)
  completedRentals  Int            @default(0)
  isFoundingAgent   Boolean        @default(false)
  zone              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/// OTP challenge issued during login. The plaintext code is hashed before
/// storage; only the digest leaves the server. Single-use — `consumedAt`
/// is set on a successful verify.
model OtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  /// SHA-256 of code + salt. Never store plaintext.
  codeHash    String
  salt        String
  /// Provider's reference (e.g. Termii pinId). Null when null-provider used.
  providerRef String?
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// Renter-on-agent / agent-on-renter review tied to a specific listing.
/// Feeds the credibility score and shows on agent profile pages.
model Review {
  id            String   @id @default(cuid())
  /// User being reviewed (the agent or the renter).
  subjectUserId String
  /// User leaving the review.
  byUserId      String
  listingId     String?
  /// 1.0 - 5.0 in 0.5 steps; enforced at API boundary, not DB.
  rating        Float
  body          String   @db.Text
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
}

// ───────────────────────── Chat & offers ─────────────────────────

/// One thread per (listing, renter, agent/landlord) trio. Created lazily the
/// first time a renter taps "Message agent" on a listing.
model Thread {
  id        String   @id @default(cuid())
  listingId String
  renterId  String
  agentId   String

  messages    ChatMessage[]
  offerEvents OfferEvent[]
  inspections Inspection[]

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@unique([listingId, renterId, agentId])
  @@index([renterId, lastActiveAt])
  @@index([agentId, lastActiveAt])
}

model ChatMessage {
  id         String    @id @default(cuid())
  threadId   String
  byUserId   String
  body       String    @db.Text
  /// When the counterparty has read this message. Null until then.
  readAt     DateTime?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

enum OfferEventType {
  offer_made
  counter_offer
  accepted
  declined
  withdrawn
}

/// Append-only audit trail for offers. The doc explicitly calls this out as
/// a renter+agent protection — every term agreed in-platform is timestamped
/// and unchangeable.
model OfferEvent {
  id            String         @id @default(cuid())
  threadId      String
  byUserId      String
  type          OfferEventType
  /// Offered price in kobo. Required for offer_made / counter_offer; null
  /// for accepted / declined / withdrawn.
  amountKobo    BigInt?
  termsSummary  String?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

enum InspectionStatus {
  proposed
  confirmed
  cancelled
  completed
  no_show
}

/// Inspection appointment booked from inside a chat thread.
model Inspection {
  id           String           @id @default(cuid())
  threadId     String
  listingId    String
  /// User the inspection is for (renter).
  forUserId    String
  /// User running the inspection (agent / landlord).
  byUserId     String
  status       InspectionStatus @default(proposed)
  scheduledAt  DateTime

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([scheduledAt, status])
  @@index([forUserId, scheduledAt])
  @@index([byUserId, scheduledAt])
}

// ───────────────────────── Listings ─────────────────────────

enum ListingType {
  short_let
  long_term
  commercial
}

enum ListingStatus {
  draft
  pending_verification
  active
  paused
  archived
  rejected
}

enum PricePeriod {
  night
  week
  month
  year
}

model Listing {
  id            String        @id @default(cuid())
  ownerId       String
  type          ListingType
  status        ListingStatus @default(draft)
  title         String
  description   String        @db.Text
  bedrooms      Int
  bathrooms     Int
  // Stored as kobo (1 NGN = 100 kobo) to avoid float drift.
  priceKobo     BigInt
  pricePeriod   PricePeriod
  neighborhood  String
  address       String
  // Geocoded WGS84 coordinates of the address.
  lat           Float
  lng           Float
  amenities     String[]
  verifiedAt    DateTime?
  /// Optional publish window. Listings only appear in /listings results
  /// inside [publishStartAt, publishEndAt). Doc §3.2 "Operations: Listing
  /// management — availability management".
  publishStartAt DateTime?
  publishEndAt   DateTime?

  owner             User                @relation(fields: [ownerId], references: [id])
  photos            ListingPhoto[]
  verificationJobs  VerificationJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, neighborhood])
  @@index([type, neighborhood, priceKobo])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  url       String
  position  Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

// ───────────────────────── Verification ─────────────────────────

enum VerificationJobStatus {
  unclaimed
  claimed
  submitted
  approved
  rejected
}

enum VerificationArtefactKind {
  photo
  video
  floorplan
}

model VerificationJob {
  id                String                @id @default(cuid())
  listingId         String
  status            VerificationJobStatus @default(unclaimed)
  operatorId        String?
  // Distance in metres between operator GPS and listing geocoded address.
  gpsMismatchMetres Float?
  decisionReason    String?

  listing   Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  artefacts VerificationArtefact[]

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}

model VerificationArtefact {
  id         String                   @id @default(cuid())
  jobId      String
  kind       VerificationArtefactKind
  url        String
  capturedAt DateTime
  lat        Float?
  lng        Float?

  job VerificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Credibility ─────────────────────────

enum CredibilityFactor {
  review_rating
  inspection_show_up
  verified_listing_ratio
  response_time
  completed_rental
  listing_accuracy
  account_history
}

model CredibilityEvent {
  id            String            @id @default(cuid())
  subjectUserId String
  factor        CredibilityFactor
  delta         Float
  reason        String
  contextRef    String?

  subject User @relation("CredibilitySubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subjectUserId, factor, createdAt])
}

// ───────────────────────── Escrow ─────────────────────────

enum EscrowKind {
  inspection_fee
  short_let_booking
  long_term_rent
}

enum EscrowState {
  created
  funded
  released
  refunded
  disputed
  expired
}

model Escrow {
  id            String      @id @default(cuid())
  kind          EscrowKind
  state         EscrowState @default(created)
  payerId       String
  payeeId       String
  listingId     String?
  amountKobo    BigInt
  feeKobo       BigInt
  // Custodian's identifier (Anchor account/transfer ref). Null until funded.
  custodianRef  String?
  autoReleaseAt DateTime?

  events    EscrowEvent[]
  disputes  Dispute[]

  createdAt  DateTime  @default(now())
  fundedAt   DateTime?
  resolvedAt DateTime?

  @@index([state, autoReleaseAt])
}

/// Append-only audit trail. Every state transition writes a row. The current
/// Escrow.state is a denormalisation of the latest event for query speed.
model EscrowEvent {
  id          String      @id @default(cuid())
  escrowId    String
  fromState   EscrowState
  toState     EscrowState
  reason      String?
  actorUserId String?

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([escrowId, createdAt])
}

enum DisputeStatus {
  open
  evidence
  resolved_payer
  resolved_payee
}

model Dispute {
  id              String        @id @default(cuid())
  escrowId        String
  openedByUserId  String
  status          DisputeStatus @default(open)
  reason          String        @db.Text
  evidenceUrls    String[]
  decisionNotes   String?

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ───────────────────────── Documents (on-chain) ─────────────────────────

enum DocumentType {
  tenancy_agreement
  inspection_report
  escrow_receipt
  dispute_outcome
  credibility_snapshot
}

enum AnchorStatus {
  pending
  submitted
  confirmed
  failed
}

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  hash         String       @unique
  uri          String
  contextRef   String
  anchorStatus AnchorStatus @default(pending)
  txHash       String?
  blockNumber  Int?

  createdAt   DateTime  @default(now())
  anchoredAt  DateTime?

  @@index([anchorStatus, createdAt])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationKind {
  message_new
  offer_made
  offer_countered
  offer_accepted
  offer_declined
  inspection_proposed
  inspection_confirmed
  inspection_reminder_24h
  inspection_reminder_1h
  escrow_funded
  escrow_released
  escrow_refunded
  escrow_disputed
  listing_verified
  listing_rejected
}

enum NotificationChannel {
  push
  email
  sms
  inapp
}

enum NotificationStatus {
  pending
  sent
  failed
}

/// User-facing notification. Persisted regardless of delivery channel so
/// the bell-icon list shows it even if push/email fails.
model Notification {
  id        String              @id @default(cuid())
  userId    String
  kind      NotificationKind
  /// Short title rendered in the push payload + inbox row.
  title     String
  body      String              @db.Text
  /// In-app deep link (e.g. /chat/abc123).
  href      String?
  /// Free-form context for the consumer side (chat threadId, escrowId…).
  contextRef String?
  channel   NotificationChannel @default(push)
  status    NotificationStatus  @default(pending)
  readAt    DateTime?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([status, createdAt])
}

// ───────────────────────── User restrictions & flags ─────────────────────────

enum UserRestrictionKind {
  warning
  inspection_cooldown
  account_suspended
  permanent_ban
}

/// Admin-issued restriction on a user account. Active iff `expiresAt` is
/// null or in the future. The doc explicitly lists "Misrepresented listing:
/// immediate delisting, credibility score docked, possible permanent ban"
/// as anti-fraud measures.
model UserRestriction {
  id          String              @id @default(cuid())
  userId      String
  issuedById  String
  kind        UserRestrictionKind
  reason      String              @db.Text
  expiresAt   DateTime?
  liftedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

enum ListingFlagStatus {
  open
  resolved_valid
  resolved_invalid
}

/// Community flag against an active listing. Per doc §2.3 "Community
/// flagging on all active listings".
model ListingFlag {
  id            String            @id @default(cuid())
  listingId     String
  flaggedById   String
  reason        String            @db.Text
  evidenceUrls  String[]
  status        ListingFlagStatus @default(open)
  decisionNotes String?

  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([listingId, status])
  @@index([status, createdAt])
}

// ───────────────────────── Audit log ─────────────────────────

/// Append-only record of every admin mutation. Per cross-cutting concerns
/// in plan.md §8 ("audit log for admin actions") and the NDPR-driven
/// requirement to be able to answer "who changed what, when".
model AuditLog {
  id          String   @id @default(cuid())
  /// Admin user who performed the action.
  actorUserId String
  /// Domain entity affected — e.g. listing, dispute, flag, restriction.
  entity      String
  entityId    String
  /// Verb tag — e.g. "approve_verification", "decide_dispute", "ban_user".
  action      String
  /// Sanitised JSON snapshot of relevant fields at the time of action.
  /// Never includes PII (NIN, BVN, raw phone).
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

// ───────────────────────── Phase 2: saved searches ─────────────────────────

/// Renter-defined search criteria. Phase-2 push alerts fire when a listing
/// activates that matches an existing row (doc §2.2: "new listing push alerts
/// for saved searches"; doc §4.1: "first-access listing alerts").
model SavedSearch {
  id            String       @id @default(cuid())
  userId        String
  /// Optional friendly label for the inbox (e.g. "Yaba 2-bed").
  label         String?
  type          ListingType?
  neighborhood  String?
  bedrooms      Int?
  minPriceKobo  BigInt?
  maxPriceKobo  BigInt?
  /// High-water mark — listings with a verifiedAt past this point haven't
  /// alerted yet. Updated each time the alert worker fires.
  lastAlertedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, neighborhood])
}

// ───────────────────────── Phase 2: subscriptions (agent CRM) ─────────────────────────

enum SubscriptionPlan {
  agent_crm_basic
  agent_crm_pro
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  expired
}

/// Agent CRM subscription (doc §3.2 + §6 Tier 2). ₦15-25K/mo via Paystack
/// subscriptions; the Iloja-side row is the source of truth, the provider
/// reference comes from Paystack.
model Subscription {
  id           String             @id @default(cuid())
  userId       String
  plan         SubscriptionPlan
  status       SubscriptionStatus @default(active)
  /// Paystack subscription code or equivalent. Null when null-payments stub.
  providerRef  String?
  amountKobo   BigInt
  /// Active iff currentPeriodEnd > now AND status = active.
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cancelledAt DateTime?

  @@index([userId, status])
}

// ───────────────────────── Phase 2: affiliates ─────────────────────────

enum AffiliateCategory {
  movers
  internet
  dstv
  cleaning
  furniture
  utilities
}

/// Affiliate partner (movers, internet, DSTV, cleaning…). Per doc §6 Tier 2:
/// "perfectly timed (renter just confirmed) and require no additional
/// acquisition cost". Each click writes an AffiliateClick we can later
/// reconcile against partner reports for commission.
model Affiliate {
  id              String            @id @default(cuid())
  category        AffiliateCategory
  name            String
  /// Short pitch shown next to the click-out CTA.
  blurb           String
  /// Outbound URL — partner-supplied with a tracking code embedded.
  url             String
  /// Display order within the category. Lower = higher.
  rank            Int               @default(100)
  /// Soft toggle so ops can pause partners without deleting the row.
  active          Boolean           @default(true)

  clicks AffiliateClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active, rank])
}

/// One row per click-through. Captures the user (when known) and a
/// freeform context string (e.g. the escrow id that surfaced the strip).
model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  userId      String?
  contextRef  String?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([affiliateId, createdAt])
}

// ───────────────────────── Phase 2: payouts ─────────────────────────

/// Bank account a user (operator, agent, landlord) is paid into. We store
/// only the routing fields needed for Paystack/Anchor transfers — never the
/// full PAN or anything that should sit behind PCI scope.
model UserBankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  /// Nigerian bank short code (Paystack-compatible).
  bankCode      String
  accountNumber String
  accountName   String
  /// Returned by Paystack `verify` — proves the (code, number) pair belongs
  /// to the given user. Null until verified.
  verifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayoutKind {
  operator_verification
  agent_escrow_release
  landlord_escrow_release
  refund
}

enum PayoutStatus {
  queued
  succeeded
  failed
  reversed
}

/// Audit-grade record of every outbound transfer. We persist before calling
/// the provider so a stray webhook can be reconciled even if the request
/// itself never succeeded.
model Payout {
  id           String       @id @default(cuid())
  userId       String
  kind         PayoutKind
  amountKobo   BigInt
  /// Free-form reference for our own records (e.g. verificationJobId,
  /// escrowId). Kept distinct from providerRef so we can still find the row
  /// when the provider hasn't responded yet.
  contextRef   String?
  /// Provider-side reference (Paystack transfer code or equivalent).
  providerRef  String?
  status       PayoutStatus @default(queued)
  failureReason String?

  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([contextRef])
}
