# Iloja environment template. Copy to .env.local in each app as needed.
# Real secrets live in Vercel/Render env config — never check them in.

# ──────── Database ────────
DATABASE_URL="postgresql://iloja:iloja@localhost:5432/iloja?schema=public"

# ──────── Redis (BullMQ) ────────
REDIS_URL="redis://localhost:6379"

# ──────── Auth ────────
AUTH_SECRET=
TERMII_API_KEY=
TERMII_SENDER_ID="Iloja"

# ──────── KYC (Dojah) ────────
DOJAH_APP_ID=
DOJAH_API_KEY=
DOJAH_BASE_URL="https://api.dojah.io"

# ──────── Payments (Paystack) ────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ──────── Escrow custodian (Anchor) ────────
ANCHOR_API_KEY=
ANCHOR_BASE_URL="https://api.getanchor.co"

# ──────── Storage (Cloudflare R2) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET="iloja-uploads"

# ──────── Maps (Mapbox) ────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ──────── On-chain (Base L2) ────────
BASE_RPC_URL="https://mainnet.base.org"
DOCUMENT_REGISTRY_ADDRESS=
ANCHOR_RELAYER_PRIVATE_KEY=

# ──────── Observability ────────
SENTRY_DSN=

# ──────── PII encryption ────────
# 32 bytes, base64-encoded. Used for at-rest encryption of NIN/BVN.
PII_ENCRYPTION_KEY=
